{
  "name": "ecommerce",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "start": "node server/index.js",
    "build": "npx prisma generate && vite build",
    "preview": "vite preview",
    "deploy": "git pull origin main && npm install && npm run build && pm2 restart ecosystem.config.js",
    "prisma:generate": "npx prisma generate",
    "prisma:push": "npx prisma db push",
    "seed": "node server/seed.js",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{js,json,html,prisma}\""
  },
  "devDependencies": {
    "autoprefixer": "^10.4.27",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prisma": "^7.6.0",
    "tailwindcss": "^3.4.19",
    "vite": "^8.0.1"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/client": "^7.6.0",
    "@prisma/config": "^7.7.0",
    "@studio-freight/lenis": "^1.0.42",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "gsap": "^3.11.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "sharp": "^0.34.5"
  }
}
